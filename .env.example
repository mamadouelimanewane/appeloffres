# Copier ce fichier en .env.local (jamais envoyé sur GitHub) et renseigner UNE clé.

# IA pour lire les avis (npm run ia) : DeepSeek (essai) ou Claude (plus tard)
IA_FOURNISSEUR=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# IA_MODELE=deepseek-flash

# Rédaction du mémoire technique sur le site (facultatif)
# ANTHROPIC_API_KEY=

# Console d'administration /super-admin (obligatoire en ligne, sinon la page est fermée)
# Mot de passe : 12 caractères au moins. À mettre dans Vercel → Settings → Environment Variables.
# ADMIN_UTILISATEUR=
# ADMIN_MOT_DE_PASSE=

# Base de données Supabase (docs/base-de-donnees.md). Sans ces deux lignes : mode démonstration.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, serveur uniquement — ne jamais la partager ni la mettre dans le code
# SUPABASE_SERVICE_ROLE_KEY=
# Confirmation de paiement simulée tant que PayTech n'est pas branché
# PAIEMENT_SIMULE=1
